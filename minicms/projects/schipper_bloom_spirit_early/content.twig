{#
  Schipper – Bloom Spirit / Early Access

  Kampagnendaten – pro Kampagne anpassen:
#}
{% set early_access_start = '2026-08-13T00:00:00+02:00' %}
{% set launch_date        = '2026-08-14T00:00:00+02:00' %}
{% set timezone           = 'Europe/Berlin' %}
{% set shop_url           = 'https://www.malennachzahlen-schipper.com/schipper_de/home/' %}
{% set instagram_url      = 'https://www.instagram.com/schipper_malennachzahlen/' %}
{% set date_format        = 'common.date_format' | trans %}
{% set date_access        = early_access_start | date(date_format, timezone) %}
{% set date_launch        = launch_date | date(date_format, timezone) %}

<div class="schipper_bloom_spirit">

  {% if standalone.is_standalone() %}
    <header class="schipper_bloom_spirit__header">
      <img class="schipper_bloom_spirit__logo"
           src="{{ media.get_asset_link('public/schipper_logo.png') }}"
           alt="{{ 'banner_logo' | trans | escape('html_attr') }}" width="440" height="311">
    </header>
  {% endif %}

  {# ============ HERO ============ #}
  <section class="schipper_bloom_spirit__hero">
    <div class="schipper_bloom_spirit__hero_bg"
         style="background-image:url('{{ media.get_asset_link('public/hero_bloom_spirit.jpg') }}')"></div>
    <div class="schipper_bloom_spirit__wrap schipper_bloom_spirit__hero_inner">
      <p class="schipper_bloom_spirit__eyebrow">{{ 'hero.eyebrow' | trans }}</p>
      <h1 class="schipper_bloom_spirit__hero_title">{{ 'hero.title' | trans }}</h1>
      <p class="schipper_bloom_spirit__hero_sub">{{ 'hero.subtitle' | trans }}</p>
      <p class="schipper_bloom_spirit__hero_limit">{{ 'hero.limited' | trans }}</p>
      <a class="schipper_bloom_spirit__btn schipper_bloom_spirit__hero_cta"
         href="#" data-sbs-scroll-to="signup">{{ 'hero.cta' | trans }}</a>

      <div class="schipper_bloom_spirit__countdown" role="timer"
           data-sbs-countdown="{{ early_access_start | escape('html_attr') }}"
           aria-label="{{ 'countdown.aria' | trans | escape('html_attr') }}">
        {% for unit in ['days', 'hours', 'minutes', 'seconds'] %}
          {% if not loop.first %}
            <div class="schipper_bloom_spirit__cd_sep" aria-hidden="true">:</div>
          {% endif %}
          <div class="schipper_bloom_spirit__cd_unit">
            <div class="schipper_bloom_spirit__cd_num" data-sbs-cd="{{ unit }}">--</div>
            <div class="schipper_bloom_spirit__cd_label">{{ ('countdown.' ~ unit) | trans }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ============ ANMELDUNG ============ #}
  {#
    TODO D2S: Hier gehoert @shared/newsletter.twig hin. Das Formular unten ist
    ein Platzhalter mit reiner Frontend-Validierung – es werden KEINE Daten
    uebertragen und kein Captcha eingebunden. In diesem Zustand nicht live gehen.
  #}
  <section class="schipper_bloom_spirit__signup" data-sbs-section="signup">
    <div class="schipper_bloom_spirit__wrap">
      <div data-sbs-form-view>
        <h2 class="schipper_bloom_spirit__signup_title">{{ 'signup.heading' | trans }}</h2>
        <p class="schipper_bloom_spirit__claim">{{ 'signup.claim' | trans }}</p>
        <p class="schipper_bloom_spirit__body">{{ 'signup.body' | trans }}</p>

        <form class="schipper_bloom_spirit__form_row" data-sbs-form novalidate>
          <input class="schipper_bloom_spirit__input" data-sbs-field="firstname" type="text"
                 autocomplete="given-name"
                 placeholder="{{ 'signup.firstname_placeholder' | trans | escape('html_attr') }}"
                 aria-label="{{ 'signup.firstname_label' | trans | escape('html_attr') }}">
          <input class="schipper_bloom_spirit__input" data-sbs-field="email" type="email"
                 autocomplete="email"
                 placeholder="{{ 'signup.email_placeholder' | trans | escape('html_attr') }}"
                 aria-label="{{ 'signup.email_label' | trans | escape('html_attr') }}">
          <button class="schipper_bloom_spirit__btn" type="submit">{{ 'signup.submit' | trans }}</button>
        </form>

        <p class="schipper_bloom_spirit__error" data-sbs-error role="alert" aria-live="polite"></p>
        <p class="schipper_bloom_spirit__consent">
          {{ 'signup.consent_newsletter' | trans }}<br>
          {{ 'signup.consent_privacy' | trans }}
        </p>
      </div>

      <div class="schipper_bloom_spirit__success" data-sbs-success-view hidden>
        <h2 class="schipper_bloom_spirit__signup_title">{{ 'success.heading' | trans }}</h2>
        <p>{{ 'success.body' | trans({'%date_access%': date_access}) }}</p>
        <a class="schipper_bloom_spirit__btn" href="{{ shop_url }}">{{ 'success.cta' | trans }}</a>
      </div>
    </div>
  </section>

  {# ============ EARLY-ACCESS-VORTEIL ============ #}
  <section class="schipper_bloom_spirit__benefit">
    <div class="schipper_bloom_spirit__benefit_inner">
      <h2>{{ 'benefit.heading' | trans }}</h2>
      <p class="schipper_bloom_spirit__benefit_lead">
        {{ 'benefit.lead' | trans({'%date_access%': date_access, '%date_launch%': date_launch}) | raw }}
      </p>
      <a class="schipper_bloom_spirit__btn schipper_bloom_spirit__btn_light"
         href="#" data-sbs-scroll-to="signup">{{ 'benefit.cta' | trans }}</a>

      <h3>{{ 'benefit.list_heading' | trans }}</h3>
      <ul class="schipper_bloom_spirit__benefit_list">
        <li>{{ 'benefit.item_1' | trans }}</li>
        <li>{{ 'benefit.item_2' | trans({'%date_access%': date_access}) }}</li>
        <li>{{ 'benefit.item_3' | trans }}</li>
        <li>{{ 'benefit.item_4' | trans }}</li>
        <li>{{ 'benefit.item_5' | trans }}</li>
      </ul>
    </div>
  </section>

  {# ============ STORY ============ #}
  <section class="schipper_bloom_spirit__story">
    <div class="schipper_bloom_spirit__story_inner">
      <div class="schipper_bloom_spirit__story_grid">
        <figure class="schipper_bloom_spirit__story_fig">
          <img src="{{ media.get_asset_link('public/motiv_teaser.jpg') }}"
               alt="{{ 'story.image_alt' | trans | escape('html_attr') }}" loading="lazy">
        </figure>
        <div class="schipper_bloom_spirit__story_text">
          <h2>{{ 'story.heading' | trans }}</h2>
          <p>{{ 'story.p1' | trans }}</p>
          <p>{{ 'story.p2' | trans }}</p>
          <p>{{ 'story.p3' | trans }}</p>
        </div>
      </div>
    </div>
  </section>

  {# ============ LIMITIERTE AUFLAGE ============ #}
  <section class="schipper_bloom_spirit__limited">
    <div class="schipper_bloom_spirit__limited_inner">
      <h2>{{ 'limited.heading' | trans }}</h2>
      <p>{{ 'limited.body' | trans }}</p>
      <a class="schipper_bloom_spirit__btn schipper_bloom_spirit__btn_light"
         href="#" data-sbs-scroll-to="signup">{{ 'limited.cta' | trans }}</a>
    </div>
  </section>

  {# ============ HINTER DEN KULISSEN ============ #}
  {#
    TODO Content: finales Video fehlt noch. Einbindung spaeter lokal ueber
    media.get_asset_link('public/…mp4') – kein YouTube-/Vimeo-Embed.
  #}
  <section class="schipper_bloom_spirit__behind">
    <div class="schipper_bloom_spirit__wrap">
      <h2>{{ 'behind.heading' | trans }}</h2>
      <div class="schipper_bloom_spirit__video_ph">
        <div class="schipper_bloom_spirit__video_play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
        </div>
        <span>{{ 'behind.placeholder' | trans }}</span>
      </div>
    </div>
  </section>

  {# ============ ENTDECKE MEHR ============ #}
  <section class="schipper_bloom_spirit__more">
    <div class="schipper_bloom_spirit__more_inner">
      <div class="schipper_bloom_spirit__more_copy">
        <h2>{{ 'more.heading' | trans }}</h2>
        <p>{{ 'more.body' | trans | raw }}</p>
        <a class="schipper_bloom_spirit__btn" href="{{ shop_url }}">{{ 'more.cta' | trans }}</a>
      </div>
      <div class="schipper_bloom_spirit__polaroids" aria-hidden="true">
        <figure class="schipper_bloom_spirit__pola schipper_bloom_spirit__pola_1">
          <img src="{{ media.get_asset_link('public/polaroid_outdoor.jpg') }}"
               alt="{{ 'more.image_1_alt' | trans | escape('html_attr') }}" loading="lazy">
        </figure>
        <figure class="schipper_bloom_spirit__pola schipper_bloom_spirit__pola_2">
          <img src="{{ media.get_asset_link('public/polaroid_wall.jpg') }}"
               alt="{{ 'more.image_2_alt' | trans | escape('html_attr') }}" loading="lazy">
        </figure>
      </div>
    </div>
  </section>

  {% if standalone.is_standalone() %}
    <footer class="schipper_bloom_spirit__footer">
      <a class="schipper_bloom_spirit__foot_ig" href="{{ instagram_url }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
        </svg>{{ 'footer.instagram' | trans }}
      </a>
    </footer>
  {% endif %}

</div>
